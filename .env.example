# WhatsApp Automation Manager — configuration.
# Copy to .env and fill in, or just run the app and let first-run setup write it.
#
# Startup is load -> validate -> launch. Anything invalid is reported all at
# once on a startup screen, so you fix everything in one pass.

# --- storage ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017

# Which database on that server. One cluster often holds more than one
# deployment. MongoDB's own (admin, local, config) are refused.
DATABASE_NAME=wa_events

# Where the JSON mirror is written, and how long writes are coalesced over.
# 0 = write through.
# JSON_BACKUP_FOLDER=backup
# JSON_AUTOSAVE_INTERVAL=15

# --- OpenWA, the transport ----------------------------------------------
# The gateway this application sends through and receives from.
OPENWA_URL=http://localhost:2785

# From OpenWA's data/.api-key, or its dashboard's API keys page.
OPENWA_API_KEY=

# The session's UUID, not its name. GET /api/sessions lists them.
OPENWA_SESSION_ID=

# --- the webhook this application listens on ----------------------------
# Register this address in OpenWA for the message.received event:
#   http://host.docker.internal:8765/hook
#
# `host.docker.internal`, not `localhost` — OpenWA resolves the URL from inside
# its container, where `localhost` is the container itself. That is also why
# the bind address below is 0.0.0.0 rather than 127.0.0.1: a loopback listener
# is unreachable from the container.
#
# OpenWA's SSRF guard blocks private addresses by default. Allow this one with
# SSRF_ALLOWED_HOSTS=host.docker.internal in OpenWA's own .env.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8765

# Use this same value as the webhook's `secret` in OpenWA, so a delivery can be
# proven to have come from it. Required whenever WEBHOOK_HOST is not loopback,
# which — see above — it has to be.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- behaviour ----------------------------------------------------------
# Per-chat quiet period. Bounds an automation answering an automation. 0
# disables it, which is only sensible when the other end is definitely a person.
# COOLDOWN_SECONDS=60

# Answer group chats too. Off by default: a bot in a group is louder than a bot
# in a DM, and easier to turn on than to live down.
# ANSWER_GROUPS=false

# --- the inbound send API -----------------------------------------------
# Lets something POST {"id", "message"} in to send a message to a chat, where
# `id` is a chat name, a phone number, or a chat id. Off until a port is set.
#
# Loopback-bound by default, where a token is optional. Bind it anywhere else
# — which you must, to reach it from another machine — and API_TOKEN becomes
# mandatory at 16+ characters. Configuration refuses to start without one:
# off loopback, that token is the only thing between the network and your
# WhatsApp account.
#
# Running this on a remote machine: see docs/DEPLOYMENT.md. An SSH tunnel is
# better than an open port, and lets API_HOST stay on loopback.
# API_PORT=8766
# API_HOST=127.0.0.1
# API_TOKEN=
# API_SEND_TIMEOUT=60

# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
