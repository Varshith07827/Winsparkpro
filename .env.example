# WhatsApp Automation Manager — configuration.
#
# Two values are required. Everything else has a working default, and the
# commented settings below exist so they can be discovered without reading the
# source; leaving them alone is the normal case.

# Where chats, contacts and messages are stored.
MONGODB_URI=mongodb://localhost:27017

# OpenWA's API key — in its data/.api-key file, or its dashboard.
OPENWA_API_KEY=

# ── that is everything required ─────────────────────────────────────────
#
# On startup this application works out the rest: it finds the session (when
# the instance has exactly one), generates a webhook secret and remembers it,
# and registers its own webhook with OpenWA so incoming messages arrive. If
# OpenWA has more than one session, startup says so and lists them.

# Where OpenWA is, if not here.
# OPENWA_URL=http://localhost:2785

# Received photos and files are written here, and this is also the ONLY
# directory a file may be sent from — put things to send in its outbox/.
# A webhook reply may name a path, and a webhook endpoint is somebody else's
# code; unconfined, that would let it name any file on this machine.
# MEDIA_FOLDER=data/media

# Largest media file kept or sent, in megabytes.
# MEDIA_MAX_MB=32

# Which session, when there is more than one. The session's id, not its name.
# OPENWA_SESSION_ID=

# Where incoming messages are POSTed, for chats with no URL of their own. Set a
# per-chat URL in the window to override it. With neither, messages are stored
# and nothing is dispatched.
# DEFAULT_WEBHOOK=https://your.server/hook

# Sent to your endpoint as `Authorization: Bearer …`.
# WEBHOOK_API_KEY=

# ── the listener ────────────────────────────────────────────────────────
# 0.0.0.0 because OpenWA usually runs in Docker and reaches the host as
# `host.docker.internal`; a loopback listener is unreachable from there.
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8765
#
# The address OpenWA delivers to. Defaults to host.docker.internal:<port>.
# Set this if OpenWA is somewhere else, or reaches this machine by another name.
# WEBHOOK_PUBLIC_URL=
#
# Set explicitly only to share a secret with something else that already
# registered the webhook. Left unset, one is generated and stored.
# WEBHOOK_SECRET=
#
# Turn off if something other than this application owns the registration.
# REGISTER_WEBHOOK=true

# ── behaviour ───────────────────────────────────────────────────────────
# Per-chat quiet period, seconds. Bounds an automation answering an automation.
# COOLDOWN_SECONDS=60
# Answer group chats. A bot in a group is louder than a bot in a DM.
# ANSWER_GROUPS=false
# Retries cover transport errors, 5xx and 429; a 4xx fails at once.
# WEBHOOK_TIMEOUT=20
# WEBHOOK_MAX_RETRIES=3

# ── the send API ────────────────────────────────────────────────────────
# POST {"id": "<name|number|chat id>", "msg": "..."} to send. Off until a port
# is set. Loopback-bound by default, where a token is optional; bind it
# anywhere else and API_TOKEN becomes mandatory at 16+ characters.
# API_PORT=8766
# API_HOST=127.0.0.1
# API_TOKEN=

# Which database on the server, and where the JSON mirror goes.
# DATABASE_NAME=wa_events
# JSON_BACKUP_FOLDER=backup
# LOG_LEVEL=INFO
