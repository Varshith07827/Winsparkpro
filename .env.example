# WhatsApp Automation — configuration
# Written by the first-run setup. Everything not listed here is fixed
# (3s polling) or derived (per-chat webhook URLs).

# Where chats and messages are stored.
MONGODB_URI=mongodb://localhost:27017

# Which database on that server. One cluster often holds more than one
# deployment — a staging run and real messages should not share a
# database. MongoDB's own (admin, local, config) are refused.
DATABASE_NAME=wa_events

# The webhook, and it carries BOTH directions over one address:
#
#   inbound   a message arrives in a ticked chat  → POST to this URL
#   outbound  every few seconds                   → GET this URL, and
#                                                    send what it returns
#
# {phone_number} is replaced with each chat's own number. Return an
# empty body from the GET when nothing is waiting.
WEBHOOK_URL=https://example.com/hook/?{phone_number}

# ---------------------------------------------------------------------
# Optional: accept messages pushed IN over HTTP
# ---------------------------------------------------------------------
#
# Off while the next line stays commented, and off is the right default:
# the webhook above already sends, and this opens a socket that anything
# on this machine can post to.
#
# Uncomment it if your system can reach this machine and would rather
# push than be polled. Then, from anywhere on this PC:
#
#   curl -X POST http://127.0.0.1:8765/wam/ ^
#        -H "Content-Type: application/json" ^
#        -d "{\"id\":\"919876543210\",\"message\":\"Hello\"}"
#
# `id` is the chat name, its full number, or the last four digits.
# The reply is 202 with a message id; the send is queued and verified.
#
# API_PORT=8765

# Only reachable from this machine. Change it and a token stops being
# optional — off loopback the app refuses to start without one.
# API_HOST=127.0.0.1
# API_TOKEN=
