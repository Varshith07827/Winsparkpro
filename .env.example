# WhatsApp Automation — configuration
#
# Two settings. Everything else is either fixed or worked out automatically:
#   database name      wa_events   (fixed)
#   polling            every 3s    (fixed)
#   per-chat webhooks  built from WEBHOOK_URL and each chat's phone number
#
# The first-run setup window writes this file for you. Editing it by hand is
# only necessary if you want to move the database or change the endpoint.

# Where to store chats and messages.
MONGODB_URI=mongodb://localhost:27017

# The webhook every chat is forwarded to. {phone_number} is replaced with the
# chat's own number, so one line covers every conversation.
WEBHOOK_URL=https://noteify.org/ntext/whook/?{phone_number}
