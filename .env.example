# WhatsApp Desktop Automation Manager — the entire configuration surface.
#
# Copy this file to `.env` next to it. There is no settings window: every value
# the application reads lives here, is loaded once at startup, validated, and
# then frozen for the life of the process.

# ---------------------------------------------------------------------------
# Storage (required)
# ---------------------------------------------------------------------------

# Primary datastore. Local Community Server or a cloud Atlas cluster:
#   mongodb://localhost:27017
#   mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/
MONGODB_URI=mongodb://localhost:27017

# The database application collections live in. NOT taken from the URI path —
# a URI ending in /admin is an auth-database habit, not a data location.
DATABASE_NAME=wadam

# Where the JSON backup mirror is written. Relative paths resolve against the
# project folder. Created on startup if missing.
JSON_BACKUP_FOLDER=backup

# Seconds between JSON mirror flushes. Writes are coalesced over this window so
# a 3-second poll doesn't rewrite the whole mirror ten times a minute; 0 means
# write through on every change. Every write still reaches JSON — this only
# controls how often the batch lands.
JSON_AUTOSAVE_INTERVAL=15

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------

# Webhook URL given to every NEWLY discovered chat. Leave empty for the
# documented default (new chats start with no webhook and automation OFF).
DEFAULT_WEBHOOK=

# Optional bearer token sent as `Authorization: Bearer <value>` on every
# webhook call.
WEBHOOK_API_KEY=

# Per-attempt HTTP timeout, in seconds.
WEBHOOK_TIMEOUT=20

# How many times a failing webhook call is retried (exponential backoff)
# before the message is marked failed.
WEBHOOK_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Relay  (optional — off unless RELAY_ENABLED is true)
# ---------------------------------------------------------------------------
#
# The other direction, without opening a port. The application GETs each
# automated chat's webhook URL on a schedule and sends whatever comes back:
#
#   GET https://your.server/hook   →   {"id": "42", "message": "Hello Varshith"}
#                                       └─▶ sent to that chat
#
# Same URL as the outbound webhook, two verbs: POST when a message arrives,
# GET to ask whether anything is waiting to go out. Plain text, a single
# object, or an array of them (each is sent) are all understood.
#
# Include an "id" when you can. It is how the same text can be sent twice on
# purpose; without one, a message identical to the last one relayed to that
# chat is suppressed, so a non-dequeuing endpoint sends once and goes quiet.
#
# Off by default: an endpoint written to receive POSTs should not start
# getting GETs because the application was upgraded.
RELAY_ENABLED=false

# Seconds between polls OF EACH CHAT, minimum 1. Every automated chat with a
# webhook is polled, so raise this if you have many of them.
RELAY_POLL_INTERVAL=3

# ---------------------------------------------------------------------------
# Inbound send API  (optional — off unless API_PORT is set)
# ---------------------------------------------------------------------------
#
# Lets another system tell this application to send a WhatsApp message:
#
#   curl -X POST http://127.0.0.1:8765/wam/ \
#        -H "Content-Type: application/json" \
#        -H "Authorization: Bearer <API_TOKEN>" \
#        -d '{"id":"9423","message":"Hello Varshith"}'
#
# `id` is the chat's contact ID — by default the last four digits of the
# contact's number. It is filled in automatically when the chat name is the
# number itself; for a saved contact (which WhatsApp shows by name, never by
# number) type it into the chat's configuration panel.
#
# The request does not return until the message has been sent AND verified, so
# a 200 means it actually arrived.

# Port to listen on. Empty or 0 = the API is disabled entirely.
API_PORT=

# Bind address. 127.0.0.1 (the default) cannot be reached from another machine
# at all. Change this only deliberately — see the token note below.
API_HOST=127.0.0.1

# Optional on loopback, REQUIRED (16+ characters) for any other API_HOST.
# 127.0.0.1 cannot be reached from another machine, so an open listener there
# exposes this machine only to itself; bound anywhere else, this token is the
# only thing between the network and your WhatsApp. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# How long a send request may take before the caller gets a 504. Sending
# involves bringing WhatsApp forward, opening the chat and verifying delivery.
API_SEND_TIMEOUT=60

# ---------------------------------------------------------------------------
# WhatsApp Desktop
# ---------------------------------------------------------------------------

# Substring matched against the WhatsApp window title. The window is found by
# process name first (WhatsApp.exe); this only disambiguates when more than one
# candidate window is visible.
WHATSAPP_WINDOW_TITLE=WhatsApp

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# The polling interval is FIXED at 3 seconds in code (wadam/constants.py) and
# is deliberately not configurable. Listed here for documentation only —
# changing it has no effect, and the app logs a warning if it is set to
# anything other than 3.
POLL_INTERVAL=3
